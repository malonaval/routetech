{
  "rewrites": [
    {
      "source": "/api/groq/:path*",
      "destination": "https://api.groq.com/:path*"
    },
    {
      "source": "/api/gmaps/:path*",
      "destination": "https://maps.googleapis.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
